{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile and learning metadata",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique user ID" },
        "email": { "type": "string", "description": "User email address" },
        "name": { "type": "string", "description": "Display name" },
        "photoURL": { "type": "string", "description": "Avatar URL" },
        "role": { "type": "string", "enum": ["student", "admin"], "description": "User permission role" },
        "class": { "type": "string", "description": "Academic level/class" },
        "bio": { "type": "string", "description": "Short bio" },
        "createdAt": { "type": "string", "description": "Account creation timestamp" },
        "solvedCount": { "type": "number", "description": "Coding problems solved" },
        "xp": { "type": "number", "description": "Gamification experience points" },
        "streak": { "type": "number", "description": "Daily study streak" }
      },
      "required": ["uid", "email"]
    },
    "StudyPlan": {
      "title": "StudyPlan",
      "description": "Personalized study timetable and roadmap generated by Study Dost",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "examType": { "type": "string" },
        "targetYear": { "type": "string" },
        "dailyHours": { "type": "number" },
        "subjects": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title"]
    },
    "CareerReport": {
      "title": "CareerReport",
      "description": "AI career counseling analysis report and roadmap",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentName": { "type": "string" },
        "careerPath": { "type": "string" },
        "examTarget": { "type": "string" },
        "strengths": { "type": "array" },
        "roadmap": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["id"]
    },
    "Resume": {
      "title": "Resume",
      "description": "ATS-friendly tech and academic resume document",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "personalInfo": { "type": "object" },
        "education": { "type": "array" },
        "experience": { "type": "array" },
        "skills": { "type": "array" },
        "projects": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id"]
    },
    "Post": {
      "title": "Post",
      "description": "Chairman broadcast post or announcement",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "authorEmail": { "type": "string" },
        "authorName": { "type": "string" },
        "likes": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["content"]
    },
    "Course": {
      "title": "Course",
      "description": "Masterclass or tutorial course with YouTube live features",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "level": { "type": "string" },
        "instructor": { "type": "string" },
        "thumbnail": { "type": "string" },
        "isPaid": { "type": "boolean" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "allowedStudents": { "type": "array" },
        "features": { "type": "array" },
        "liveClass": { "type": "object" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title"]
    },
    "EnrollmentRequest": {
      "title": "EnrollmentRequest",
      "description": "Student payment proof and access request for paid courses",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "courseId": { "type": "string" },
        "courseTitle": { "type": "string" },
        "studentEmail": { "type": "string" },
        "studentName": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "paymentRef": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "courseId", "studentEmail"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "UserProfile" },
      "description": "User profiles and credentials"
    },
    "/users/{userId}/studyPlans/{planId}": {
      "schema": { "$ref": "StudyPlan" },
      "description": "Personalized study roadmaps per user"
    },
    "/users/{userId}/careerReports/{reportId}": {
      "schema": { "$ref": "CareerReport" },
      "description": "Career counseling reports per user"
    },
    "/users/{userId}/resumes/{resumeId}": {
      "schema": { "$ref": "Resume" },
      "description": "Private user resumes"
    },
    "/publicResumes/{resumeId}": {
      "schema": { "$ref": "Resume" },
      "description": "Public shared resumes"
    },
    "/posts/{postId}": {
      "schema": { "$ref": "Post" },
      "description": "Chairman broadcast updates and community posts"
    },
    "/courses/{courseId}": {
      "schema": { "$ref": "Course" },
      "description": "Academy courses with YouTube live classes and pricing"
    },
    "/enrollmentRequests/{requestId}": {
      "schema": { "$ref": "EnrollmentRequest" },
      "description": "Student course enrollment and payment verifications"
    }
  }
}
